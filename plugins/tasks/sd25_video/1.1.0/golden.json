{
  "cases": [
    {
      "name": "decode pins app-秒 while body model is the facade",
      "hook": "protocols",
      "path": [
        "openai_video",
        "decodeRequest"
      ],
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "sd2.5-G3-特惠-1",
              "prompt": "城市夜景",
              "seconds": "5",
              "resolution": "720p",
              "ratio": "16:9",
              "enable_audio": true
            }
          },
          "model": "seedance-2.5-app-秒",
          "upstreamModel": "seedance-2.5",
          "protocol": "openai_video",
          "operation": "create",
          "stream": false
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "seedance-2.5-app-秒",
        "action": "text_to_video",
        "requestBody": {
          "model": "seedance-2.5",
          "prompt": "城市夜景",
          "seconds": 5,
          "size": "1280x720",
          "enable_audio": true
        }
      }
    },
    {
      "name": "decode echoes a pinned facade and rewrites the upstream model",
      "hook": "protocols",
      "path": [
        "openai_video",
        "decodeRequest"
      ],
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "sd2.5-G3-特惠-2",
              "prompt": "a",
              "seconds": 8,
              "size": "720p"
            }
          },
          "model": "sd2.5-G3-特惠-2",
          "protocol": "openai_video",
          "operation": "create",
          "stream": false
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "sd2.5-G3-特惠-2",
        "action": "text_to_video",
        "requestBody": {
          "model": "seedance-2.5",
          "prompt": "a",
          "seconds": 8,
          "size": "1280x720",
          "enable_audio": true
        }
      }
    },
    {
      "name": "decode rejects a body model this plugin does not serve",
      "hook": "protocols",
      "path": [
        "openai_video",
        "decodeRequest"
      ],
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "sora-2",
              "prompt": "a",
              "seconds": 5,
              "size": "1280x720"
            }
          },
          "model": "seedance-2.5-app-条",
          "protocol": "openai_video",
          "operation": "create",
          "stream": false
        }
      ],
      "expectedError": "model must be seedance-2.5 or a declared SD2.5 name"
    },
    {
      "name": "decode rejects multipart",
      "hook": "protocols",
      "path": [
        "openai_video",
        "decodeRequest"
      ],
      "args": [
        {
          "body": {
            "kind": "multipart",
            "fields": {},
            "files": []
          },
          "model": "seedance-2.5",
          "protocol": "openai_video",
          "operation": "create",
          "stream": false
        }
      ],
      "expectedError": "multipart is not supported"
    },
    {
      "name": "buildSubmit accepts OriginModelName facade and sends seedance-2.5",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://sd25.app/",
          "apiKey": "sk-test",
          "authHeader": "Bearer sk-test",
          "upstream": {
            "kind": "vendor"
          },
          "files": [],
          "action": "",
          "publicTaskId": "task_pub",
          "requestHeaders": {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "model": "sd2.5-G3-特惠-1",
          "upstreamModel": "seedance-2.5-app-秒",
          "requestBody": {
            "model": "seedance-2.5",
            "prompt": "城市夜景",
            "seconds": 5,
            "size": "1280x720",
            "enable_audio": true
          }
        }
      ],
      "expected": {
        "url": "https://sd25.app/v1/videos",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer sk-test",
          "Content-Type": "application/json"
        },
        "body": {
          "model": "seedance-2.5",
          "prompt": "城市夜景",
          "seconds": 5,
          "size": "1280x720",
          "enable_audio": true
        }
      }
    },
    {
      "name": "buildSubmit accepts an unlisted UpstreamModelName without rejecting model mapping",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://sd25.app/",
          "apiKey": "sk-test",
          "authHeader": "Bearer sk-test",
          "upstream": {
            "kind": "vendor"
          },
          "files": [],
          "action": "",
          "publicTaskId": "task_pub",
          "requestHeaders": {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "model": "sd2.5-G3-特惠-1",
          "upstreamModel": "vendor-endpoint-id",
          "requestBody": {
            "model": "sd2.5-G3-特惠-1",
            "prompt": "夜景",
            "seconds": 6,
            "resolution": "1080p",
            "aspect": "1:1",
            "enable_audio": false
          }
        }
      ],
      "expected": {
        "url": "https://sd25.app/v1/videos",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer sk-test",
          "Content-Type": "application/json"
        },
        "body": {
          "model": "seedance-2.5",
          "prompt": "夜景",
          "seconds": 6,
          "size": "1080x1080",
          "enable_audio": false
        }
      }
    },
    {
      "name": "buildSubmit rejects remix",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://sd25.app/",
          "apiKey": "sk-test",
          "authHeader": "Bearer sk-test",
          "upstream": {
            "kind": "vendor"
          },
          "files": [],
          "action": "remix",
          "publicTaskId": "task_pub",
          "requestHeaders": {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "model": "seedance-2.5",
          "requestBody": {
            "prompt": "x",
            "seconds": 4,
            "size": "1280x720"
          }
        }
      ],
      "expectedError": "remix"
    },
    {
      "name": "extractUsage from a normalized body",
      "hook": "extractUsage",
      "args": [
        {
          "baseUrl": "https://sd25.app/",
          "apiKey": "sk-test",
          "authHeader": "Bearer sk-test",
          "upstream": {
            "kind": "vendor"
          },
          "files": [],
          "action": "",
          "publicTaskId": "task_pub",
          "requestHeaders": {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "model": "sd2.5-G3-特惠-1",
          "upstreamModel": "vendor-endpoint-id",
          "requestBody": {
            "model": "seedance-2.5",
            "prompt": "城市夜景",
            "seconds": 5,
            "size": "1280x720",
