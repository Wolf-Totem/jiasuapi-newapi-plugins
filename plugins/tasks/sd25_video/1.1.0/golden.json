      }
    },
    {
      "name": "listArtifacts on success",
      "hook": "listArtifacts",
      "args": [
        {
          "taskId": "task_pub",
          "status": "SUCCESS",
          "action": "text_to_video",
          "data": {},
          "producerVersion": "1.1.0"
        }
      ],
      "expected": [
        {
          "key": "video",
          "type": "video"
        }
      ]
    },
    {
      "name": "buildContentRequest",
      "hook": "buildContentRequest",
      "args": [
        {
          "baseUrl": "https://sd25.app/",
          "apiKey": "sk-test",
          "authHeader": "Bearer sk-test",
          "upstream": {
            "kind": "vendor"
          },
          "files": [],
          "action": "",
          "publicTaskId": "task_pub",
          "requestHeaders": {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "artifactKey": "video",
          "upstreamTaskId": "vid_123",
          "clientRequest": {
            "method": "GET",
            "headers": {
              "Range": "bytes=0-1"
            }
          }
        }
      ],
      "expected": {
        "url": "https://sd25.app/v1/videos/vid_123/content",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer sk-test",
          "X-Media-Protocol": "openai_video",
          "Cache-Control": "no-cache, no-store, max-age=0",
          "Pragma": "no-cache",
          "Range": "bytes=0-1"
        }
      }
    },
    {
      "name": "render keeps the literal when the host context has no model",
      "hook": "protocols",
      "path": [
        "openai_video",
        "render"
      ],
      "args": [
        {
          "protocol": "openai_video",
          "operation": "retrieve"
        },
        {
          "task_id": "task_pub",
          "status": "SUCCESS",
          "progress": "100%",
          "created_at": 10,
          "finished_at": 20,
          "data": {
            "status": "completed",
            "seconds": 5,
            "size": "1280x720",
            "enable_audio": true
          }
        }
      ],
      "expected": {
        "id": "task_pub",
        "object": "video",
        "model": "seedance-2.5",
        "status": "completed",
        "created_at": 10,
        "progress": 100,
        "seconds": 5,
        "size": "1280x720",
        "enable_audio": true,
        "provider_status": "completed",
        "completed_at": 20
      }
    },
    {
      "name": "render echoes ctx.model when the host supplies it",
      "hook": "protocols",
      "path": [
        "openai_video",
        "render"
      ],
      "args": [
        {
          "model": "sd2.5-G3-特惠-1"
        },
        {
          "task_id": "task_pub",
          "status": "IN_PROGRESS",
          "progress": "10%",
          "created_at": 10,
          "data": {
            "status": "in_progress"
          }
        }
      ],
      "expected": {
        "id": "task_pub",
        "object": "video",
        "model": "sd2.5-G3-特惠-1",
        "status": "in_progress",
        "created_at": 10,
        "progress": 10,
        "provider_status": "in_progress"
      }
    }
  ]
}
