    },
    {
      "name": "extractUsageOnComplete reads upstream facts",
      "hook": "extractUsageOnComplete",
      "args": [
        {},
        {},
        {
          "seconds": 7,
          "size": "1920x1080",
          "enable_audio": false
        }
      ],
      "expected": {
        "seconds": 7,
        "resolution": "1080p",
        "enable_audio": false
      }
    },
    {
      "name": "parseSubmitResponse",
      "hook": "parseSubmitResponse",
      "args": [
        {},
        {
          "statusCode": 200,
          "headers": {},
          "body": {
            "id": "vid_123",
            "status": "queued",
            "seconds": 5,
            "size": "1280x720",
            "enable_audio": true
          }
        }
      ],
      "expected": {
        "taskId": "vid_123",
        "taskData": {
          "seconds": 5,
          "size": "1280x720",
          "enable_audio": true,
          "status": "queued",
          "provider_status": "queued"
        }
      }
    },
    {
      "name": "parseTaskResult in progress",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "status": "processing",
          "progress": 40
        },
        {
          "status": 200,
          "headers": {}
        }
      ],
      "expected": {
        "status": "IN_PROGRESS",
        "progress": "40%"
      }
    },
    {
      "name": "parseTaskResult unknown status stays UNKNOWN",
      "hook": "parseTaskResult",
      "args": [
        {},
        {
          "status": "mystery"
        },
        {
          "status": 200,
          "headers": {}
        }
      ],
      "expected": {
        "status": "UNKNOWN",
        "reason": "暂时无法查询最新状态，请继续查询原任务。"
      }
    },
    {
      "name": "buildQueryRequest",
      "hook": "buildQueryRequest",
      "args": [
        {
          "baseUrl": "https://sd25.app/",
          "apiKey": "sk-test",
          "authHeader": "Bearer sk-test",
          "upstream": {
            "kind": "vendor"
          },
          "files": [],
          "action": "",
