    {
      "name": "render keeps the literal when the host context has no model",
      "hook": "protocols",
      "path": [
        "openai_video",
        "render"
      ],
      "args": [
        {
          "protocol": "openai_video",
          "operation": "retrieve"
        },
        {
          "task_id": "task_pub",
          "status": "SUCCESS",
          "progress": "100%",
          "created_at": 10,
          "finished_at": 20,
          "data": {
            "status": "completed",
            "seconds": 5,
            "size": "1280x720",
            "enable_audio": true
          }
        }
      ],
      "expected": {
        "id": "task_pub",
        "object": "video",
        "model": "seedance-2.5",
        "status": "completed",
        "created_at": 10,
        "progress": 100,
        "seconds": 5,
        "size": "1280x720",
        "enable_audio": true,
        "provider_status": "completed",
        "completed_at": 20
      }
    },
