{
  "cases": [
    {
      "name": "decode pins app-秒 while body model is the facade",
      "hook": "protocols",
      "path": [
        "openai_video",
        "decodeRequest"
      ],
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "sd2.5-G3-特惠-1",
              "prompt": "城市夜景",
              "seconds": "5",
              "resolution": "720p",
              "ratio": "16:9",
              "enable_audio": true
            }
          },
          "model": "seedance-2.5-app-秒",
          "upstreamModel": "seedance-2.5",
          "protocol": "openai_video",
          "operation": "create",
          "stream": false
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "seedance-2.5-app-秒",
        "action": "text_to_video",
        "requestBody": {
          "model": "seedance-2.5",
          "prompt": "城市夜景",
          "seconds": 5,
          "resolution": "720p",
          "aspect_ratio": "16:9",
          "enable_audio": true
        }
      }
    },
    {
      "name": "decode sends a size resolution token as resolution and aspect_ratio",
      "hook": "protocols",
      "path": [
        "openai_video",
        "decodeRequest"
      ],
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "sd2.5-G3-特惠-2",
              "prompt": "a",
              "seconds": 8,
              "size": "720p"
            }
          },
          "model": "sd2.5-G3-特惠-2",
          "protocol": "openai_video",
          "operation": "create",
          "stream": false
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "sd2.5-G3-特惠-2",
        "action": "text_to_video",
        "requestBody": {
          "model": "seedance-2.5",
          "prompt": "a",
          "seconds": 8,
          "resolution": "720p",
          "aspect_ratio": "16:9",
          "enable_audio": true
        }
      }
    },
    {
      "name": "decode rejects a body model this plugin does not serve",
      "hook": "protocols",
      "path": [
        "openai_video",
        "decodeRequest"
      ],
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "sora-2",
              "prompt": "a",
              "seconds": 5,
              "size": "1280x720"
            }
          },
          "model": "seedance-2.5-app-条",
          "protocol": "openai_video",
          "operation": "create",
          "stream": false
        }
      ],
      "expectedError": "model must be seedance-2.5 or a declared SD2.5 name"
    },
    {
      "name": "decode rejects multipart",
      "hook": "protocols",
      "path": [
        "openai_video",
        "decodeRequest"
      ],
      "args": [
        {
          "body": {
            "kind": "multipart",
            "fields": {},
            "files": []
          },
          "model": "seedance-2.5",
          "protocol": "openai_video",
          "operation": "create",
          "stream": false
        }
      ],
      "expectedError": "multipart is not supported"
    },
